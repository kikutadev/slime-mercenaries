    "generate:enemy:magma-crab": "/Applications/Blender.app/Contents/MacOS/Blender --background --python tools/blender/enemies/build.py -- --slug magma-crab --output public/assets/enemies/magma-crab.glb",
    "generate:enemy:furnace-turtle": "/Applications/Blender.app/Contents/MacOS/Blender --background --python tools/blender/enemies/build.py -- --slug furnace-turtle --output public/assets/enemies/furnace-turtle.glb",
